# Medusa backend environment
# Copy to apps/backend/.env and replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-different-long-random-string

# Optional: only set these to enable the official S3-compatible file provider.
# Leave all S3_* values unset for the default local file storage during development.
# S3_FILE_URL=https://YOUR_CUSTOM_DOMAIN_OR_R2_DEV_URL
# S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
# S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# S3_BUCKET=replace-with-r2-bucket-name
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
