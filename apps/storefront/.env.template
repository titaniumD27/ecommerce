# Medusa backend URL used by the storefront
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Create this in Medusa Admin under Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_after_creating_key
# Two-letter default region/country code configured in Medusa
NEXT_PUBLIC_DEFAULT_REGION=us
# Public storefront URL used for canonical URLs and metadata
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Optional payment provider public keys; leave blank until the provider is configured.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test

# Optional Medusa Cloud image settings.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
NODE_ENV=development
